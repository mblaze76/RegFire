{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private build infrastructure for approved RegFire staging container. No application deployment or data migration.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Resources": {
    "Source": {
      "Type": "AWS::S3::Bucket",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private temporary build source; no credentials/data uploaded",
          "must": "RegFire synthetic staging builds only; no private files in source archive."
        }
      },
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldBuildSources",
              "Status": "Enabled",
              "ExpirationInDays": 14,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "SourcePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Deny all insecure transport",
          "must": "RegFire synthetic staging builds only; no private files in source archive."
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "Source"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Source",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Source.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Immutable staging image versions; retained for rollback",
          "must": "RegFire synthetic staging builds only; no private files in source archive."
        }
      },
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Redacted build output",
          "must": "RegFire synthetic staging builds only; no private files in source archive."
        }
      },
      "Properties": {
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Build service can read only source bucket and push only this repository",
          "must": "RegFire synthetic staging builds only; no private files in source archive."
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BuildOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Source.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Source",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:CompleteLayerUpload",
                    "ecr:InitiateLayerUpload",
                    "ecr:PutImage",
                    "ecr:UploadLayerPart",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Repository",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Build": {
      "Type": "AWS::CodeBuild::Project",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Ephemeral managed Docker build; no local Docker installation or customer data",
          "must": "RegFire synthetic staging builds only; no private files in source archive."
        }
      },
      "Properties": {
        "ServiceRole": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Source": {
          "Type": "S3",
          "Location": {
            "Fn::Sub": "${Source}/source.zip"
          }
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:8.0",
          "PrivilegedMode": true,
          "EnvironmentVariables": [
            {
              "Name": "IMAGE_REPO",
              "Value": {
                "Fn::GetAtt": [
                  "Repository",
                  "RepositoryUri"
                ]
              }
            },
            {
              "Name": "IMAGE_TAG",
              "Value": "review"
            }
          ]
        },
        "TimeoutInMinutes": 20,
        "QueuedTimeoutInMinutes": 10,
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "Logs"
            }
          }
        }
      }
    },
    "Budget": {
      "Type": "AWS::Budgets::Budget",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Console-visible project cost safeguard; no notifications and no spending cap",
          "must": "Do not send email or change billing plan"
        }
      },
      "Properties": {
        "Budget": {
          "BudgetName": {
            "Fn::Sub": "${AWS::StackName}-monthly-100"
          },
          "BudgetLimit": {
            "Amount": 100,
            "Unit": "USD"
          },
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "CostTypes": {
            "IncludeCredit": false,
            "IncludeRefund": false
          }
        }
      }
    }
  },
  "Outputs": {
    "SourceBucket": {
      "Description": "SourceBucket",
      "Value": {
        "Ref": "Source"
      }
    },
    "RepositoryArn": {
      "Description": "RepositoryArn",
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "Arn"
        ]
      }
    },
    "RepositoryUri": {
      "Description": "RepositoryUri",
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "BuildProject": {
      "Description": "BuildProject",
      "Value": {
        "Ref": "Build"
      }
    }
  }
}
