{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated RegFire synthetic staging: HTTPS ECS, private RDS and durable EFS. No corporate changes or real attendee migration.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "Hostname": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+",
      "Description": "Approved staging hostname; distinct from corporate apex"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:us-east-2:[0-9]{12}:certificate/.+"
    },
    "ImageDigest": {
      "Type": "String",
      "AllowedPattern": ".+@sha256:[a-f0-9]{64}"
    },
    "ImageRepositoryArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:ecr:us-east-2:[0-9]{12}:repository/.+"
    },
    "OwnerSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:us-east-2:[0-9]{12}:secret:.+"
    },
    "StagingOwnerEmail": {
      "Type": "String",
      "AllowedPattern": "[^@ ]+@[^@ ]+"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "EnabledSyntheticFlows": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "([a-f0-9-]{36}(,[a-f0-9-]{36})*)?"
    }
  },
  "Rules": {
    "OhioOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-2"
            ]
          },
          "AssertDescription": "Deploy only in the verified project Region us-east-2."
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Isolated staging network",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "CidrBlock": "10.78.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Internet": {
      "Type": "AWS::EC2::InternetGateway",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public TLS ingress and task outbound image retrieval",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {}
    },
    "Attach": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Attach only the isolated VPC",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Internet"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public network for ALB and ingress-restricted tasks; no NAT baseline cost",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Outbound network; no direct task ingress",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Internet"
        }
      },
      "DependsOn": "Attach"
    },
    "Public0": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "ALB/task subnet",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.78.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Public0Routes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public routing only for compute/ingress",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "Public0"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "Private0": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private database subnets have no Internet route",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.78.20.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Public1": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "ALB/task subnet",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.78.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Public1Routes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public routing only for compute/ingress",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "Public1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "Private1": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private database subnets have no Internet route",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.78.21.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "HTTPS only; application preserves account and event boundaries",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "GroupDescription": "TLS registration ingress",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "No direct Internet access to app port",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "GroupDescription": "Only ALB may reach app",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          }
        ]
      }
    },
    "DataSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private data endpoints",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "GroupDescription": "Only tasks may access PostgreSQL and EFS",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurity"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 2049,
            "ToPort": 2049,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurity"
            }
          }
        ]
      }
    },
    "DbSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "No public route to database",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "DBSubnetGroupDescription": "Private staging database",
        "SubnetIds": [
          {
            "Ref": "Private0"
          },
          {
            "Ref": "Private1"
          }
        ]
      }
    },
    "DbParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "TLS required for every database connection",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "Description": "Require PostgreSQL TLS",
        "Family": "postgres17",
        "Parameters": {
          "rds.force_ssl": "1"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Single-AZ synthetic staging; master secret only for one-shot migration",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": "17.11",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 40,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "regfire",
        "MasterUsername": "regfire_migrator",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "DBParameterGroupName": {
          "Ref": "DbParameters"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DataSecurity"
          }
        ],
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "MultiAZ": false,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "RuntimeSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated runtime credential without schema-owner grants",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "Description": "Staging runtime database password",
        "GenerateSecretString": {
          "PasswordLength": 40,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Uploads": {
      "Type": "AWS::EFS::FileSystem",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Durable private uploads with encrypted transport; no public URL",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "Encrypted": true,
        "BackupPolicy": {
          "Status": "ENABLED"
        },
        "FileSystemPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "elasticfilesystem:Client*",
              "Resource": "*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "UploadAccess": {
      "Type": "AWS::EFS::AccessPoint",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Limit task filesystem identity and root",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "FileSystemId": {
          "Ref": "Uploads"
        },
        "PosixUser": {
          "Uid": "10001",
          "Gid": "10001"
        },
        "RootDirectory": {
          "Path": "/regfire-uploads",
          "CreationInfo": {
            "OwnerUid": "10001",
            "OwnerGid": "10001",
            "Permissions": "0700"
          }
        }
      }
    },
    "Mount0": {
      "Type": "AWS::EFS::MountTarget",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private NFS mount target",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "FileSystemId": {
          "Ref": "Uploads"
        },
        "SubnetId": {
          "Ref": "Private0"
        },
        "SecurityGroups": [
          {
            "Ref": "DataSecurity"
          }
        ]
      }
    },
    "Mount1": {
      "Type": "AWS::EFS::MountTarget",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private NFS mount target",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "FileSystemId": {
          "Ref": "Uploads"
        },
        "SubnetId": {
          "Ref": "Private1"
        },
        "SecurityGroups": [
          {
            "Ref": "DataSecurity"
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Application logs omit query strings, credentials and attendee answers",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "App task can load only its own restricted database secret",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "RuntimeStartup",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "ImageRepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "RuntimeSecret"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "MigrationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Privileged secret access only for explicit migration task",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "MigrationStartup",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "ImageRepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "RuntimeSecret"
                    },
                    {
                      "Fn::GetAtt": [
                        "Database",
                        "MasterUserSecret.SecretArn"
                      ]
                    },
                    {
                      "Ref": "OwnerSecretArn"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "No cloud administration privileges; only this upload filesystem",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PrivateUploads",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticfilesystem:ClientMount",
                    "elasticfilesystem:ClientWrite"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Uploads",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "elasticfilesystem:AccessPointArn": {
                        "Fn::GetAtt": [
                          "UploadAccess",
                          "Arn"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated low-volume staging cluster",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled"
          }
        ]
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Gunicorn single-worker staging runtime; immutable image digest and private storage",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "regfire",
            "Image": {
              "Ref": "ImageDigest"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "PortMappings": [
              {
                "ContainerPort": 8080
              }
            ],
            "Environment": [
              {
                "Name": "REGFIRE_ENV",
                "Value": "production"
              },
              {
                "Name": "REGFIRE_PUBLIC_ORIGIN",
                "Value": {
                  "Fn::Sub": "https://${Hostname}"
                }
              },
              {
                "Name": "REGFIRE_STAGING",
                "Value": "1"
              },
              {
                "Name": "REGFIRE_STAGING_FLOW_IDS",
                "Value": {
                  "Ref": "EnabledSyntheticFlows"
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "DB_USER",
                "Value": "regfire_runtime"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Ref": "RuntimeSecret"
                }
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "private",
                "ContainerPath": "/app/.local"
              },
              {
                "SourceVolume": "tmp",
                "ContainerPath": "/tmp"
              },
              {
                "SourceVolume": "uploads",
                "ContainerPath": "/app/uploads"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "runtime"
              }
            },
            "StopTimeout": 60
          }
        ],
        "Volumes": [
          {
            "Name": "private"
          },
          {
            "Name": "tmp"
          },
          {
            "Name": "uploads",
            "EFSVolumeConfiguration": {
              "FilesystemId": {
                "Ref": "Uploads"
              },
              "TransitEncryption": "ENABLED",
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "UploadAccess"
                },
                "IAM": "ENABLED"
              }
            }
          }
        ]
      }
    },
    "MigrationTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Explicit migration/bootstrap job; never runs automatically at web startup",
          "must": "Synthetic staging only; preserve local and corporate environments."
        }
      },
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "MigrationExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "migration",
            "Image": {
              "Ref": "ImageDigest"
            },
            "Essential": true,
            "Command": [
              "python",
              "deploy/migrate.py"
            ],
            "Environment": [
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
